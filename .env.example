APP_NAME="PPID - Empat Lawang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production uses MySQL 8 (DB_CONNECTION=mysql + DB_HOST..DB_PASSWORD, or DB_URL).
DB_CONNECTION=sqlite
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (reset password). Lokal: MAIL_MAILER=log (tulis ke storage/logs) atau array.
# Produksi: smtp — port 587 + MAIL_SCHEME=smtp (STARTTLS) atau 465 + MAIL_SCHEME=smtps (SSL).
# Cek koneksi: php artisan mail:test alamat@tujuan
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="ppid@example.com"
MAIL_FROM_NAME="PPID Kabupaten Empat Lawang"

# S3-compatible storage (used for the "public" disk — all uploads).
# Leave S3_ENDPOINT empty (or set PUBLIC_DISK_DRIVER=local) to store uploads
# in storage/app/public served at /storage — run `php artisan storage:link`.
# PUBLIC_DISK_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ROOT_DIR=
S3_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Main admin created by UserSeeder (db:seed). Production: user is only created when ADMIN_PASSWORD is set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Bearer token for the REST API (/api/v1, see API.md). Empty = API closed (401).
API_TOKEN=
# Limited token for content pushers (scraper/n8n): only list/show/create/update news & galleries. Empty = disabled.
API_INJECT_TOKEN=

# Sapa Madani chat (OpenAI Chat Completions). Empty key = falls back to assistant_api_url / fixed reply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
